<Window x:Class="CantatePresenter.Views.UserManualDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Instrukcja Obsługi — CantatePresenter"
        Width="980" Height="680"
        WindowStartupLocation="CenterOwner"
        Background="#18181b"
        Foreground="#f4f4f5">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Bar -->
        <Border Grid.Row="0" Background="#27272a" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="📖 Instrukcja Obsługi CantatePresenter" FontWeight="Bold" FontSize="16" Foreground="#38bdf8" VerticalAlignment="Center"/>
                    <TextBlock Text="Wersja 1.0.0 (Windows 11)" FontSize="12" Foreground="#a1a1aa" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Otwórz plik INSTRUKCJA.md" Click="OpenMarkdown_Click" Padding="10,6" Margin="0,0,8,0" Background="#3f3f46" Foreground="#ffffff" BorderThickness="0"/>
                    <Button Content="GitHub Projektu" Click="OpenGitHub_Click" Padding="10,6" Background="#2563eb" Foreground="#ffffff" BorderThickness="0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Content Grid -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar Chapters -->
            <Border Grid.Column="0" Background="#27272a" CornerRadius="8" Padding="8">
                <DockPanel>
                    <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Margin="0,0,0,8" Padding="6" Background="#18181b" Foreground="#ffffff" BorderBrush="#3f3f46"
                             TextChanged="SearchBox_TextChanged" />
                    <ListBox x:Name="ChaptersListBox" Background="#18181b" BorderBrush="#3f3f46" SelectionChanged="ChaptersListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Title}" Padding="6,4" FontSize="12" FontWeight="SemiBold" Foreground="#ffffff"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#3f3f46"/>

            <!-- Chapter Content Viewer -->
            <Border Grid.Column="2" Background="#27272a" CornerRadius="8" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="ChapterTitleText" Text="Wybierz rozdział" FontWeight="Bold" FontSize="18" Foreground="#38bdf8" Margin="0,0,0,12"/>
                        <Separator Background="#3f3f46" Margin="0,0,0,16"/>
                        <TextBlock x:Name="ChapterBodyText" Text="" FontSize="13" LineHeight="20" Foreground="#e4e4e7" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Footer -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Zamknij" Width="100" Height="32" Click="Close_Click" Background="#2563eb" Foreground="#ffffff" FontWeight="Bold" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
