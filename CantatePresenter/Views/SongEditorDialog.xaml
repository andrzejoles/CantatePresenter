<Window x:Class="CantatePresenter.Views.SongEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edytor Pieśni — CantatePresenter"
        Width="920" Height="680"
        WindowStartupLocation="CenterOwner"
        Background="#18181b"
        Foreground="#f4f4f5">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Metadata Header -->
        <Border Grid.Row="0" Background="#27272a" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="Tytuł utworu:" FontWeight="SemiBold" FontSize="12" Foreground="#a1a1aa" Margin="0,0,0,4"/>
                    <TextBox x:Name="TitleBox" FontSize="14" Padding="6" Background="#18181b" Foreground="#ffffff" BorderBrush="#3f3f46"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="Autor / Źródło:" FontWeight="SemiBold" FontSize="12" Foreground="#a1a1aa" Margin="0,0,0,4"/>
                    <TextBox x:Name="AuthorBox" FontSize="14" Padding="6" Background="#18181b" Foreground="#ffffff" BorderBrush="#3f3f46"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Tonacja:" FontWeight="SemiBold" FontSize="12" Foreground="#a1a1aa" Margin="0,0,0,4"/>
                    <TextBox x:Name="KeyBox" FontSize="14" Padding="6" Background="#18181b" Foreground="#ffffff" BorderBrush="#3f3f46"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Center: Editor & Live Preview Split -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Text Editor with Section Toolbar -->
            <DockPanel Grid.Column="0">
                <!-- Section Insert Buttons -->
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button Content="+ [Zwrotka]" Click="InsertTag_Click" Tag="[Zwrotka]" Margin="0,0,6,6" Padding="8,4" Background="#3f3f46" Foreground="#ffffff" BorderThickness="0"/>
                    <Button Content="+ [Refren]" Click="InsertTag_Click" Tag="[Refren]" Margin="0,0,6,6" Padding="8,4" Background="#2563eb" Foreground="#ffffff" BorderThickness="0" FontWeight="Bold"/>
                    <Button Content="+ [Coda]" Click="InsertTag_Click" Tag="[Coda]" Margin="0,0,6,6" Padding="8,4" Background="#d97706" Foreground="#ffffff" BorderThickness="0"/>
                    <Button Content="+ [Bridge]" Click="InsertTag_Click" Tag="[Bridge]" Margin="0,0,6,6" Padding="8,4" Background="#7c3aed" Foreground="#ffffff" BorderThickness="0"/>
                    <Button Content="+ [Przejście]" Click="InsertTag_Click" Tag="[Przejście]" Margin="0,0,6,6" Padding="8,4" Background="#059669" Foreground="#ffffff" BorderThickness="0"/>
                    <Button Content="+ [Zakończenie]" Click="InsertTag_Click" Tag="[Zakończenie]" Margin="0,0,6,6" Padding="8,4" Background="#dc2626" Foreground="#ffffff" BorderThickness="0"/>
                </WrapPanel>

                <TextBox x:Name="LyricsBox" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                         FontFamily="Consolas, Segoe UI" FontSize="13" Padding="10"
                         Background="#27272a" Foreground="#ffffff" BorderBrush="#3f3f46"
                         TextChanged="LyricsBox_TextChanged"/>
            </DockPanel>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#3f3f46"/>

            <!-- Right: Live Slide Cards Preview -->
            <Border Grid.Column="2" Background="#27272a" CornerRadius="8" Padding="10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Podgląd podziału na slajdy:" FontWeight="Bold" FontSize="12" Foreground="#38bdf8" Margin="0,0,0,8"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="PreviewStack" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Footer Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Anuluj" Width="90" Height="32" Margin="0,0,10,0" Click="Cancel_Click" Background="#3f3f46" Foreground="#ffffff" BorderThickness="0"/>
            <Button Content="Zapisz pieśń" Width="120" Height="32" Click="Save_Click" Background="#2563eb" Foreground="#ffffff" FontWeight="Bold" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
