<Window x:Class="CantatePresenter.Views.QuickTextDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Szybki tekst na żywo — CantatePresenter"
        Width="620" Height="480"
        MinWidth="460" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="#18181b"
        Foreground="#f4f4f5">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#27272a" CornerRadius="8" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="⚡" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Szybki tekst na żywo" FontWeight="Bold" FontSize="16" Foreground="#f59e0b" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Wpisz treść lub ogłoszenie — zostanie wyświetlone na projektorze bez zapisywania w bibliotece pieśni."
                           FontSize="11" Foreground="#a1a1aa" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Title field -->
        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="Tytuł / nagłówek (opcjonalny):" FontSize="11" Foreground="#a1a1aa" Margin="0,0,0,4"/>
            <TextBox x:Name="TitleBox" Padding="6" FontSize="13" Background="#27272a" Foreground="#ffffff" BorderBrush="#3f3f46"
                     Text="Szybki tekst"/>
        </StackPanel>

        <!-- Lyrics / Text editor -->
        <DockPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock DockPanel.Dock="Top" Text="Treść do wyświetlenia (puste linie dzielą na kolejne slajdy):" FontSize="11" Foreground="#a1a1aa" Margin="0,0,0,4"/>
            <TextBox x:Name="LyricsBox" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" Padding="10" FontSize="13"
                     Background="#27272a" Foreground="#ffffff" BorderBrush="#3f3f46"
                     FontFamily="Segoe UI" KeyDown="LyricsBox_KeyDown"/>
        </DockPanel>

        <!-- Info tip -->
        <TextBlock Grid.Row="3" Text="Wskazówka: Naciśnij Ctrl+Enter lub kliknij 'Wyświetl teraz', aby od razu rozpocząć prezentację."
                   FontSize="10" Foreground="#71717a" Margin="0,0,0,12"/>

        <!-- Bottom action buttons -->
        <DockPanel Grid.Row="4">
            <Button Content="Anuluj" IsCancel="True" Padding="14,6" Background="#3f3f46" Foreground="#ffffff" BorderThickness="0" DockPanel.Dock="Left"/>
            <Button Content="Wyświetl teraz ⚡" IsDefault="True" Click="PresentNow_Click"
                    Padding="18,6" Background="#f59e0b" Foreground="#ffffff" FontWeight="Bold" BorderThickness="0"
                    HorizontalAlignment="Right"/>
        </DockPanel>
    </Grid>
</Window>
