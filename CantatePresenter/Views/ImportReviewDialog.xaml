<Window x:Class="CantatePresenter.Views.ImportReviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Weryfikacja Importowanych Pieśni — CantatePresenter"
        Width="960" Height="650"
        WindowStartupLocation="CenterOwner"
        Background="#18181b"
        Foreground="#f4f4f5">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#27272a" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <TextBlock Text="Zweryfikuj listę pieśni przed dodaniem do bazy. Możesz odznaczyć nieprawdziwego autora (np. 'Łysa Góra'), wtedy zostanie zapisany jako 'Nieznany'." TextWrapping="Wrap" FontSize="12" Foreground="#38bdf8"/>
        </Border>

        <!-- Song list for review -->
        <DataGrid x:Name="ImportDataGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                  Background="#27272a" Foreground="#ffffff" BorderBrush="#3f3f46" RowBackground="#18181b" AlternatingRowBackground="#202024"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#3f3f46">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Importuj" Binding="{Binding ShouldImport}" Width="70"/>
                <DataGridTextColumn Header="Tytuł pieśni" Binding="{Binding Title}" Width="280"/>
                <DataGridCheckBoxColumn Header="Uwzględnij autora" Binding="{Binding IncludeAuthor}" Width="130"/>
                <DataGridTextColumn Header="Autor (odznacz = Nieznany)" Binding="{Binding Author}" Width="220"/>
                <DataGridTextColumn Header="Liczba slajdów" Binding="{Binding SlidesCount}" IsReadOnly="True" Width="100"/>
                <DataGridTextColumn Header="Tonacja" Binding="{Binding Key}" Width="70"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Footer -->
        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button Content="Zaznacz wszystkie" Click="SelectAll_Click" Padding="8,4" Margin="0,0,8,0" Background="#3f3f46" Foreground="#ffffff" BorderThickness="0"/>
                <Button Content="Odznacz autorów" Click="DeselectAllAuthors_Click" Padding="8,4" Background="#3f3f46" Foreground="#ffffff" BorderThickness="0"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Anuluj" Width="90" Height="32" Margin="0,0,10,0" Click="Cancel_Click" Background="#3f3f46" Foreground="#ffffff" BorderThickness="0"/>
                <Button Content="Zatwierdź i Importuj" Width="160" Height="32" Click="Import_Click" Background="#2563eb" Foreground="#ffffff" FontWeight="Bold" BorderThickness="0"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
