<Window x:Class="CantatePresenter.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ustawienia — CantatePresenter"
        Width="820" Height="620"
        WindowStartupLocation="CenterOwner"
        Background="#18181b"
        Foreground="#f4f4f5">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Background="#27272a" BorderBrush="#3f3f46">
            <!-- Tab 1: Ekrany i Projekcja -->
            <TabItem Header="Ekrany &amp; Wyświetlanie" Padding="12,6">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Wybór ekranu do prezentacji (Rzutnik):" FontWeight="Bold" Margin="0,0,0,6"/>
                        <ComboBox x:Name="ScreenComboBox" Height="32" Margin="0,0,0,16"/>

                        <TextBlock Text="Czcionka slajdów:" FontWeight="Bold" Margin="0,0,0,6"/>
                        <ComboBox x:Name="FontComboBox" Height="32" Margin="0,0,0,16"/>

                        <CheckBox x:Name="BoldCheckBox" Content="Pogrubiony tekst slajdów (Bold)" Margin="0,0,0,12" Foreground="#ffffff"/>
                        <CheckBox x:Name="ShadowCheckBox" Content="Cień pod tekstem (zwiększa czytelność na jasnym tle)" Margin="0,0,0,16" Foreground="#ffffff"/>

                        <TextBlock Text="Margines tekstu od krawędzi (%):" FontWeight="Bold" Margin="0,0,0,6"/>
                        <Slider x:Name="MarginSlider" Minimum="3" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,0,16"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 2: Galeria Logo (23 propozycje w tym END) -->
            <TabItem Header="Galeria Logo (23)" Padding="12,6">
                <DockPanel Padding="16">
                    <TextBlock DockPanel.Dock="Top" Text="Wybierz oficjalne logo wyświetlane na planszy czuwania:" FontWeight="Bold" Margin="0,0,0,10"/>
                    <ListBox x:Name="LogoListBox" Background="#18181b" BorderBrush="#3f3f46" SelectionChanged="LogoListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8" BorderThickness="0,0,0,1" BorderBrush="#27272a">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="#38bdf8"/>
                                        <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="#a1a1aa"/>
                                        <TextBlock Text="{Binding Category}" FontSize="10" Foreground="#64748b" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>

            <!-- Tab 3: Kopia Zapasowa (Backup) -->
            <TabItem Header="Kopia Zapasowa &amp; Dysk" Padding="12,6">
                <StackPanel Padding="16">
                    <TextBlock Text="Pełna kopia zapasowa CantatePresenter (.cantatebackup):" FontWeight="Bold" Margin="0,0,0,6"/>
                    <TextBlock Text="Archiwum zawiera wszystkie pieśni, chwyty, plany nabożeństw, planszę startową, wybrane logo i ustawienia." FontSize="12" Foreground="#a1a1aa" Margin="0,0,0,16" TextWrapping="Wrap"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                        <Button Content="Utwórz kopię zapasową (.cantatebackup)..." Click="ExportBackup_Click" Padding="14,8" Background="#2563eb" Foreground="#ffffff" FontWeight="Bold" BorderThickness="0" Margin="0,0,12,0"/>
                        <Button Content="Przywróć z kopii zapasowej..." Click="RestoreBackup_Click" Padding="14,8" Background="#3f3f46" Foreground="#ffffff" BorderThickness="0"/>
                    </StackPanel>

                    <Separator Background="#3f3f46" Margin="0,0,0,16"/>

                    <TextBlock Text="Integracja z Google Drive:" FontWeight="Bold" Margin="0,0,0,6"/>
                    <TextBlock Text="Konto: " FontSize="12" Foreground="#a1a1aa" Margin="0,0,0,12"/>
                    <CheckBox x:Name="GoogleDriveAutoBackupCheckBox" Content="Automatyczna kopia zapasowa na Google Drive przy zamykaniu programu" Foreground="#ffffff"/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <!-- Bottom Footer -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Zamknij" Width="100" Height="32" Click="Close_Click" Background="#2563eb" Foreground="#ffffff" FontWeight="Bold" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
