<Window x:Class="CantatePresenter.Views.ChordsSearchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wyszukiwarka i Transpozycja Chwytów — CantatePresenter"
        Width="880" Height="620"
        WindowStartupLocation="CenterOwner"
        Background="#18181b"
        Foreground="#f4f4f5">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Search Header -->
        <Border Grid.Row="0" Background="#27272a" CornerRadius="8" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" FontSize="14" Padding="6" Background="#18181b" Foreground="#ffffff" BorderBrush="#3f3f46" KeyDown="SearchBox_KeyDown"/>
                <Button Grid.Column="1" Content="Szukaj chwytów" Click="Search_Click" Margin="8,0,0,0" Padding="14,6" Background="#2563eb" Foreground="#ffffff" FontWeight="Bold" BorderThickness="0"/>
            </Grid>
        </Border>

        <!-- Transpose Controls Bar -->
        <Border Grid.Row="1" Background="#27272a" CornerRadius="8" Padding="10" Margin="0,0,0,10">
            <DockPanel>
                <TextBlock Text="Transpozycja tonacji:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button Content="-1 półton" Click="TransposeDown_Click" Padding="10,4" Margin="0,0,6,0" Background="#3f3f46" Foreground="#ffffff" BorderThickness="0"/>
                <Button Content="+1 półton" Click="TransposeUp_Click" Padding="10,4" Margin="0,0,6,0" Background="#3f3f46" Foreground="#ffffff" BorderThickness="0"/>
                <Button Content="Oryginał" Click="TransposeReset_Click" Padding="10,4" Margin="0,0,12,0" Background="#3f3f46" Foreground="#ffffff" BorderThickness="0"/>
                <TextBlock x:Name="TransposeLabel" Text="Przesunięcie: 0 półtonów" VerticalAlignment="Center" Foreground="#38bdf8" FontWeight="SemiBold"/>
            </DockPanel>
        </Border>

        <!-- Center: Results List & Preview -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Results List -->
            <Border Grid.Column="0" Background="#27272a" CornerRadius="8" Padding="6">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Znalezione wersje akordów:" FontWeight="Bold" FontSize="11" Foreground="#a1a1aa" Margin="4,4,4,8"/>
                    <ListBox x:Name="ResultsListBox" Background="#18181b" BorderBrush="#3f3f46" SelectionChanged="ResultsListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Padding="4">
                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="#38bdf8"/>
                                    <TextBlock Text="{Binding Source}" FontSize="10" Foreground="#a1a1aa"/>
                                    <TextBlock Text="{Binding Key, StringFormat='Tonacja: {0}'}" FontSize="10" Foreground="#64748b"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#3f3f46"/>

            <!-- Preview Box -->
            <Border Grid.Column="2" Background="#27272a" CornerRadius="8" Padding="10">
                <TextBox x:Name="ChordsPreviewBox" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                         FontFamily="Consolas, Courier New" FontSize="13" Padding="8"
                         Background="#18181b" Foreground="#fef08a" BorderBrush="#3f3f46"/>
            </Border>
        </Grid>

        <!-- Footer -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Anuluj" Width="90" Height="32" Margin="0,0,10,0" Click="Cancel_Click" Background="#3f3f46" Foreground="#ffffff" BorderThickness="0"/>
            <Button Content="Zastosuj chwyty do pieśni" Width="190" Height="32" Click="Apply_Click" Background="#2563eb" Foreground="#ffffff" FontWeight="Bold" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
