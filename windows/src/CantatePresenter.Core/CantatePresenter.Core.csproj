<Project Sdk="Microsoft.NET.Sdk">
  <!-- Logika wspólna z macOS i wersją webową: bez UI, bez zależności spoza .NET, testowana na każdym systemie. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>CantatePresenter.Core</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!-- Strony pilota i dla muzyków: te same pliki serwuje aplikacja macOS. -->
    <EmbeddedResource Include="..\..\..\Sources\CantatePresenterCore\Resources\remote_page.html" LogicalName="remote_page.html" />
    <EmbeddedResource Include="..\..\..\Sources\CantatePresenterCore\Resources\stage_page.html" LogicalName="stage_page.html" />
    <!-- Wbudowana baza chwytów z macOS (windows/tools/export_chords_catalog.py). -->
    <EmbeddedResource Include="Chords\chords_catalog.json" LogicalName="chords_catalog.json" />
  </ItemGroup>
</Project>
