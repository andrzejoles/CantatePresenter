    "Brak chwytów dla tej pieśni": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No chords for this song"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Akkorde für dieses Lied"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta canción no tiene acordes"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для цієї пісні немає акордів"
          }
        }
      }
    },
    "Brak dostępu do mikrofonu. Nadaj uprawnienia w Ustawienia systemowe > Prywatność i ochrona > Mikrofon.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No access to the microphone. Grant permission in System Settings > Privacy & Security > Microphone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Zugriff auf das Mikrofon. Erteile die Berechtigung unter Systemeinstellungen > Datenschutz & Sicherheit > Mikrofon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin acceso al micrófono. Concede el permiso en Ajustes del Sistema > Privacidad y seguridad > Micrófono."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає доступу до мікрофона. Надайте дозвіл у Системних параметрах > Приватність і безпека > Мікрофон."
          }
        }
      }
    },
    "Brak dostępu. Zeskanuj ponownie kod QR w aplikacji CantatePresenter.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Access denied. Scan the QR code in CantatePresenter again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Zugriff. Scanne den QR-Code in CantatePresenter erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acceso denegado. Vuelve a escanear el código QR en CantatePresenter."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає доступу. Відскануйте QR-код у CantatePresenter ще раз."
          }
        }
      }
    },
    "Brak elementów do wyświetlenia": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing to display"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts anzuzeigen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay nada que mostrar"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає елементів для показу"
          }
        }
      }
    },
    "Brak kolejnego slajdu (Koniec pieśni)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No next slide (end of song)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine nächste Folie (Ende des Liedes)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay diapositiva siguiente (fin de la canción)"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає наступного слайда (кінець пісні)"
          }
        }
      }
    },
    "Brak opracowań chwytów spełniających filtr.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No chord arrangements match the filter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Akkordbearbeitungen entsprechen dem Filter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ningún arreglo de acordes coincide con el filtro."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає аранжувань акордів, що відповідають фільтру."
          }
        }
      }
    },
    "Brak pieśni spełniających wybrane kryteria (wszystkie mają już autora).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No songs match the selected criteria (all already have an author)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Lieder entsprechen den gewählten Kriterien (alle haben bereits einen Autor)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguna canción cumple los criterios seleccionados (todas tienen ya autor)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає пісень, що відповідають вибраним критеріям (усі вже мають автора)."
          }
        }
      }
    },
    "Brak poprzedniego stanu do przywrócenia.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No previous state to restore."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein vorheriger Zustand zum Wiederherstellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay un estado anterior que restaurar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає попереднього стану для відновлення."
          }
        }
      }
    },
    "Brak połączenia z komputerem. Sprawdź, czy telefon jest w tej samej sieci Wi-Fi.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No connection to the computer. Check that the phone is on the same Wi-Fi network."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Verbindung zum Computer. Prüfe, ob das Telefon im selben WLAN ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin conexión con el ordenador. Comprueba que el teléfono está en la misma red Wi-Fi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає з’єднання з комп’ютером. Перевірте, чи телефон у тій самій мережі Wi-Fi."
          }
        }
      }
    },
    "Brak połączenia z kontem Google. Połącz konto w Ustawieniach → Dysk Google.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not connected to a Google account. Connect your account in Settings → Google Drive."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Verbindung zu einem Google-Konto. Verbinde das Konto unter Einstellungen → Google Drive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin conexión con una cuenta de Google. Conecta la cuenta en Ajustes → Google Drive."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає з’єднання з обліковим записом Google. Під’єднайте обліковий запис у Налаштуваннях → Google Диск."
          }
        }
      }
    },
