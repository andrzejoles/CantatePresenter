    "Muzycy skanują ten kod: bieżący slajd z chwytami na tablecie lub telefonie, bez sterowania prezentacją.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Musicians scan this code: the current slide with chords on a tablet or phone, without controlling the presentation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Musiker scannen diesen Code: aktuelle Folie mit Akkorden auf Tablet oder Telefon, ohne die Präsentation zu steuern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los músicos escanean este código: la diapositiva actual con acordes en una tableta o teléfono, sin controlar la presentación."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Музиканти сканують цей код: поточний слайд з акордами на планшеті чи телефоні, без керування презентацією."
          }
        }
