    },
    "Kliknij prawym przyciskiem myszy na pieśń w bibliotece lub kliknij przycisk '+ Do planu', aby dodać pieśni.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Right-click a song in the library or click '+ Add to plan' to add songs."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke mit der rechten Maustaste auf ein Lied in der Bibliothek oder auf '+ Zum Plan', um Lieder hinzuzufügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic con el botón derecho en una canción de la biblioteca o en '+ Al plan' para añadir canciones."
          }
