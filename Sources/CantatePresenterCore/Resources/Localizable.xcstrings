    "Chwyty są dostępne dla muzyków w aplikacji i nie wyświetlają się zborowi na ekranie projekcji.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chords are available to musicians in the app and are not shown to the congregation on the projection screen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Akkorde stehen den Musikern in der App zur Verfügung und werden der Gemeinde auf dem Projektionsbildschirm nicht angezeigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los acordes están disponibles para los músicos en la aplicación y no se muestran a la asamblea en la pantalla de proyección."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Акорди доступні музикантам у програмі й не показуються громаді на екрані проєкції."
