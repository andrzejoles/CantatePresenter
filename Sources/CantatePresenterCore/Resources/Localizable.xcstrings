          }
        }
      }
    },
    "Przywróć 100% rozmiaru (Cmd 0)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore 100% size (Cmd 0)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "100 % Größe wiederherstellen (Cmd 0)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restablecer el tamaño al 100 % (Cmd 0)"
          }
        },
        "uk": {
