      }
    },
    "Przywrócono kopię zapasową": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup restored"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
