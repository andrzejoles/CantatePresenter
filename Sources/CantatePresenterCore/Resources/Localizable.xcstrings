            "state": "translated",
            "value": "No consent to access Drive. Disconnect the account, connect again and allow access to files on Drive."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Zustimmung zum Drive-Zugriff. Trenne das Konto, verbinde es erneut und erlaube den Zugriff auf Dateien in Drive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin consentimiento para acceder a Drive. Desconecta la cuenta, vuelve a conectarla y permite el acceso a los archivos de Drive."
          }
        },
        "uk": {
