    "CantatePresenter Pełny Backup (baza pieśni, chwyty, ustawienia, standby, języki, loga)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CantatePresenter full backup (song library, chords, settings, standby, languages, logos)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CantatePresenter Vollsicherung (Liederbibliothek, Akkorde, Einstellungen, Standby, Sprachen, Logos)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia completa de CantatePresenter (biblioteca de canciones, acordes, ajustes, pantalla de espera, idiomas, logotipos)"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повна резервна копія CantatePresenter (бібліотека пісень, акорди, налаштування, екран очікування, мови, логотипи)"
          }
        }
      }
    },
    "CantatePresenter to profesjonalne narzędzie macOS stworzone dla wspólnot, zespołów muzycznych, parafii oraz Ruchu Equipes Notre-Dame (END). Umożliwia prezentację słów pieśni, chwytów gitarowych i slajdów liturgicznych.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CantatePresenter is a professional macOS tool for communities, music teams, parishes and the Equipes Notre-Dame (END) movement. It presents song lyrics, guitar chords and liturgical slides."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CantatePresenter ist ein professionelles macOS-Werkzeug für Gemeinschaften, Musikteams, Pfarreien und die Bewegung Equipes Notre-Dame (END). Es präsentiert Liedtexte, Gitarrenakkorde und liturgische Folien."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "CantatePresenter es una herramienta profesional para macOS creada para comunidades, grupos de música, parroquias y el Movimiento Equipes Notre-Dame (END). Permite presentar letras de canciones, acordes de guitarra y diapositivas litúrgicas."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "CantatePresenter — професійний інструмент для macOS, створений для спільнот, музичних гуртів, парафій і руху Equipes Notre-Dame (END). Дозволяє показувати слова пісень, гітарні акорди та літургійні слайди."
          }
        }
      }
    },
    "CantatePresenter znajduje się już w folderze /Applications.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CantatePresenter is already in the /Applications folder."
