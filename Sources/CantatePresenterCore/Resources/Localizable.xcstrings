    "Sesja Google wygasła. Rozłącz konto i połącz ponownie.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Google session has expired. Disconnect the account and connect again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Google-Sitzung ist abgelaufen. Trenne das Konto und verbinde es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sesión de Google ha caducado. Desconecta la cuenta y vuelve a conectarla."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сеанс Google закінчився. Від’єднайте обліковий запис і під’єднайте знову."
          }
        }
      }
    },
    "Skala interfejsu: {0}%": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
