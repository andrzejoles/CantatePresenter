    "Źródło: Wikiźródła. Tradycyjne pieśni w domenie publicznej lub na wolnej licencji; adres strony zostaje zapisany w pieśni.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Source: Wikisource. Traditional hymns in the public domain or under a free license; the page address is saved with the song."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelle: Wikisource. Traditionelle Lieder, gemeinfrei oder unter freier Lizenz; die Seitenadresse wird im Lied gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuente: Wikisource. Canciones tradicionales de dominio público o con licencia libre; la dirección de la página se guarda en la canción."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Джерело: Вікіджерела. Традиційні пісні в суспільному надбанні або під вільною ліцензією; адреса сторінки зберігається в пісні."
          }
        }
      }
    },
    "Żółty": {
      "localizations": {
