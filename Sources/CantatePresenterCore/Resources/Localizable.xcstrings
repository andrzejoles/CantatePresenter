    "Biblioteka jest pusta. Dodaj pieśń albo zaimportuj pliki.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The library is empty. Add a song or import files."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bibliothek ist leer. Füge ein Lied hinzu oder importiere Dateien."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La biblioteca está vacía. Añade un canto o importa archivos."
          }
        },
