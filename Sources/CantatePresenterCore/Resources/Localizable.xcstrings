    "Kliknij 'Nowa pieśń' lub wybierz pieśń i kliknij 'Edytuj' (Cmd E). Edytor posiada podgląd podziału na slajdy na żywo.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click 'New song' or select a song and click 'Edit' (Cmd E). The editor shows a live preview of how the text is split into slides."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke auf 'Neues Lied' oder wähle ein Lied und klicke auf 'Bearbeiten' (Cmd E). Der Editor zeigt live, wie der Text in Folien aufgeteilt wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en 'Nueva canción' o elige una canción y haz clic en 'Editar' (Cmd E). El editor muestra en vivo cómo se divide el texto en diapositivas."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть 'Нова пісня' або виберіть пісню й натисніть 'Редагувати' (Cmd E). Редактор наживо показує, як текст ділиться на слайди."
          }
        }
      }
    },
    "Kliknij 'Rozpocznij przeszukiwanie', aby przeanalizować utwory w bibliotece.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click 'Start search' to analyse the songs in the library."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke auf 'Suche starten', um die Lieder der Bibliothek zu analysieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en 'Iniciar búsqueda' para analizar las canciones de la biblioteca."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть 'Почати пошук', щоб проаналізувати пісні в бібліотеці."
          }
        }
      }
    },
    "Kliknij 'Szukaj chwytów online' — aplikacja przeszuka polskie serwisy (tekstowo.pl, kompasje.pl) i pozwoli wstawić akordy bezpośrednio do pieśni.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click 'Search chords online' — the app searches Polish song sites (tekstowo.pl, kompasje.pl) and lets you insert chords directly into the song."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke auf 'Akkorde online suchen' – die App durchsucht polnische Liederseiten (tekstowo.pl, kompasje.pl) und fügt die Akkorde direkt in das Lied ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en 'Buscar acordes en línea': la aplicación busca en sitios polacos de canciones (tekstowo.pl, kompasje.pl) y permite insertar los acordes directamente en la canción."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть 'Шукати акорди онлайн' — програма шукає на польських сайтах пісень (tekstowo.pl, kompasje.pl) і дозволяє вставити акорди просто в пісню."
          }
        }
      }
    },
    "Kliknij 'Wyślij bieżący backup na Dysk Google' w Ustawieniach, aby utworzyć pierwszą kopię w chmurze.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click 'Upload current backup to Google Drive' in Settings to create your first cloud backup."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke in den Einstellungen auf 'Aktuelle Sicherung in Google Drive hochladen', um die erste Cloud-Sicherung zu erstellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en 'Subir la copia actual a Google Drive' en Ajustes para crear la primera copia en la nube."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть 'Вивантажити поточну копію на Google Диск' у Налаштуваннях, щоб створити першу копію в хмарі."
          }
        }
      }
    },
    "Kliknij dwukrotnie albo naciśnij F, aby włączyć pełny ekran.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Double-click or press F for full screen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Doppelklicken oder F drücken für Vollbild."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz doble clic o pulsa F para pantalla completa."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Двічі клацніть або натисніть F для повноекранного режиму."
          }
        }
      }
    },
    "Kliknij ikonę mikrofonu w edytorze lub obok paska szukania, aby podyktować słowa pieśni lub wyszukać utwór głosem.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click the microphone icon in the editor or next to the search bar to dictate song lyrics or search for a song by voice."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke auf das Mikrofonsymbol im Editor oder neben der Suchleiste, um Liedtexte zu diktieren oder ein Lied per Sprache zu suchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en el icono del micrófono en el editor o junto a la barra de búsqueda para dictar la letra o buscar una canción por voz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть значок мікрофона в редакторі або біля рядка пошуку, щоб продиктувати слова пісні чи знайти пісню голосом."
          }
        }
      }
    },
    "Kliknij lub naciśnij {0}": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click or press {0}"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicken oder {0} drücken"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic o pulsa {0}"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть або скористайтеся клавішею {0}"
          }
        }
      }
    },
    "Kliknij mikrofon obok i powiedz kilka słów...": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click the microphone next to it and say a few words..."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke auf das Mikrofon daneben und sprich ein paar Worte..."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en el micrófono de al lado y di unas palabras..."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть мікрофон поруч і скажіть кілька слів..."
          }
