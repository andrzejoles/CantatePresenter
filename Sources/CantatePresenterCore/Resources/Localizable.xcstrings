            "state": "translated",
            "value": "The text is not added to the library."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Text wird nicht in die Bibliothek aufgenommen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El texto no se añade a la biblioteca."
          }
        },
