    "Brak opracowań chwytów spełniających filtr.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No chord arrangements match the filter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Akkordbearbeitungen entsprechen dem Filter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ningún arreglo de acordes coincide con el filtro."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає аранжувань акордів, що відповідають фільтру."
          }
        }
      }
    },
    "Brak pieśni spełniających wybrane kryteria (wszystkie mają już autora).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No songs match the selected criteria (all already have an author)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Lieder entsprechen den gewählten Kriterien (alle haben bereits einen Autor)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguna canción cumple los criterios seleccionados (todas tienen ya autor)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає пісень, що відповідають вибраним критеріям (усі вже мають автора)."
          }
        }
      }
    },
    "Brak poprzedniego stanu do przywrócenia.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No previous state to restore."
