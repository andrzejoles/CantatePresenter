    "Język rozpoznawania mowy (domyślnie polski pl-PL) można ustawić w Ustawieniach.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The speech recognition language (Polish pl-PL by default) can be set in Settings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sprache der Spracherkennung (standardmäßig Polnisch pl-PL) kann in den Einstellungen festgelegt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El idioma del reconocimiento de voz (polaco pl-PL por defecto) se puede ajustar en Ajustes."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мову розпізнавання мовлення (за замовчуванням польська pl-PL) можна змінити в Налаштуваннях."
          }
        }
