    "Wpisz 6-cyfrowy kod z aplikacji uwierzytelniającej (np. Google Authenticator, Microsoft Authenticator, 1Password).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the 6-digit code from your authenticator app (e.g. Google Authenticator, Microsoft Authenticator, 1Password)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib den 6-stelligen Code aus deiner Authenticator-App ein (z. B. Google Authenticator, Microsoft Authenticator, 1Password)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce el código de 6 dígitos de tu aplicación de autenticación (p. ej. Google Authenticator, Microsoft Authenticator, 1Password)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть 6-значний код із застосунку автентифікації (напр. Google Authenticator, Microsoft Authenticator, 1Password)."
          }
        }
      }
    },
    "Wpisz fragment tekstu lub tytuł...": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter part of the lyrics or a title..."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Textausschnitt oder Titel eingeben..."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe un fragmento de la letra o un título..."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть фрагмент тексту або назву..."
          }
        }
      }
    },
    "Wpisz lub wklej treść do wyświetlenia...\n\nPuste linie dzielą tekst na kolejne slajdy.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type or paste the content to display...\n\nEmpty lines split the text into slides."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anzuzeigenden Inhalt eingeben oder einfügen...\n\nLeerzeilen teilen den Text in Folien."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe o pega el contenido que se mostrará...\n\nLas líneas vacías dividen el texto en diapositivas."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть або вставте вміст для показу...\n\nПорожні рядки ділять текст на слайди."
          }
        }
      }
    },
    "Wpisz tekst lub ogłoszenie — zostanie wyświetlone na projektorze bez zapisywania w bazie.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type text or an announcement — it will be shown on the projector without being saved in the library."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Text oder Ankündigung eingeben – sie wird auf dem Projektor gezeigt, ohne in der Bibliothek gespeichert zu werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe un texto o un aviso: se mostrará en el proyector sin guardarse en la base."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть текст або оголошення — його буде показано на проєкторі без збереження в базі."
          }
        }
      }
    },
    "Wpisz tekst ogłoszenia lub modlitwy. Pusta linia oddziela slajdy.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type an announcement or prayer. A blank line separates slides."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib eine Ankündigung oder ein Gebet ein. Eine Leerzeile trennt Folien."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe un anuncio o una oración. Una línea vacía separa diapositivas."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть оголошення або молитву. Порожній рядок розділяє слайди."
          }
        }
      }
    },
    "Wpisz tytuł i kliknij „Szukaj”, aby znaleźć chwyty gitarowe z internetowych śpiewników.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type a title and click “Search” to find guitar chords in online songbooks."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Titel eingeben und auf „Suchen“ klicken, um Gitarrenakkorde in Online-Liederbüchern zu finden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe un título y haz clic en «Buscar» para encontrar acordes de guitarra en cancioneros en línea."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть назву й натисніть «Шукати», щоб знайти гітарні акорди в онлайн-співаниках."
          }
        }
      }
    },
    "Wpisz tytuł lub fragment tekstu i kliknij 'Szukaj'": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type a title or part of the lyrics and click 'Search'"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Titel oder Textausschnitt eingeben und auf 'Suchen' klicken"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe un título o un fragmento de la letra y haz clic en 'Buscar'"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть назву або фрагмент тексту й натисніть 'Шукати'"
          }
        }
      }
    },
    "Wpisz tytuł lub słowa pieśni (np. Barka, Oceany, Dotknij Panie)...": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
