    "{0} na klawiszu Esc: Esc przestanie kończyć projekcję.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} on the Esc key: Esc will no longer end the projection."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} auf der Esc-Taste: Esc beendet die Projektion nicht mehr."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} en la tecla Esc: Esc dejará de terminar la proyección."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} на клавіші Esc: Esc більше не завершуватиме проєкцію."
          }
        }
      }
    },
    "{0} na klawiszu R: klawisz przestanie przechodzić do refrenu.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} on the R key: the key will no longer jump to the chorus."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} auf der Taste R: die Taste springt nicht mehr zum Refrain."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} en la tecla R: la tecla dejará de saltar al estribillo."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} на клавіші R: клавіша більше не переходитиме до приспіву."
