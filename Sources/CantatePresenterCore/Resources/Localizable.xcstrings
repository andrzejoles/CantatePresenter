            "value": "Galerie mit 23 Logo-Vorschlägen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Galería de 23 propuestas de logotipo"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Галерея з 23 варіантів логотипа"
          }
        }
      }
    },
    "Galeria propozycji logo aplikacji": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gallery of app logo designs"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Galerie der App-Logo-Vorschläge"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Galería de propuestas de logotipo de la aplicación"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Галерея варіантів логотипа програми"
          }
        }
      }
    },
    "Gdy nie trwa prezentacja pieśni, na rzutniku widoczna jest elegancka plansza czuwania z nazwą programu 'CantatePresenter', wersją, zegarem i wybranym logo.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When no song is being presented, the projector shows an elegant standby screen with the name 'CantatePresenter', the version, a clock and the selected logo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn kein Lied präsentiert wird, zeigt der Projektor einen eleganten Wartebildschirm mit dem Namen 'CantatePresenter', der Version, einer Uhr und dem gewählten Logo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando no se presenta ninguna canción, el proyector muestra una elegante pantalla de espera con el nombre 'CantatePresenter', la versión, un reloj y el logotipo elegido."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли пісня не показується, на проєкторі видно елегантний екран очікування з назвою 'CantatePresenter', версією, годинником і вибраним логотипом."
          }
        }
      }
    },
    "Gdy podłączony jest tylko 1 ekran, prezentacja uruchamia się w trybie pełnoekranowym na Twoim Macu. Naciśnij w dowolnym momencie klawisz ESC, aby natychmiast wrócić do aplikacji.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When only one screen is connected, the presentation runs full screen on your Mac. Press ESC at any time to return to the app immediately."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ist nur ein Bildschirm angeschlossen, läuft die Präsentation im Vollbild auf deinem Mac. Drücke jederzeit ESC, um sofort zur App zurückzukehren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si solo hay una pantalla conectada, la presentación se abre a pantalla completa en tu Mac. Pulsa ESC en cualquier momento para volver de inmediato a la aplicación."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо під’єднано лише один екран, презентація запускається на весь екран вашого Mac. Натисніть ESC будь-коли, щоб одразу повернутися до програми."
          }
        }
      }
    },
    "Gdy prezentacja pieśni nie jest aktywna, na ekranie projektora wyświetlana jest plansza powitalna HTML z wybranym logo programu.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When no song presentation is active, the projector shows an HTML welcome screen with the selected logo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn keine Liedpräsentation aktiv ist, zeigt der Projektor einen HTML-Begrüßungsbildschirm mit dem gewählten Logo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando no hay una presentación activa, el proyector muestra una pantalla de bienvenida HTML con el logotipo elegido."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли презентація пісні не активна, на проєкторі показується вітальний екран HTML з вибраним логотипом."
          }
        }
      }
    },
