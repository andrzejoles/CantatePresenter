            "value": "Прочитано з файлу"
          }
        }
      }
    },
    "Wczytywanie listy kopii zapasowych z Dysku Google...": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading the backup list from Google Drive..."
          }
        },
        "de": {
