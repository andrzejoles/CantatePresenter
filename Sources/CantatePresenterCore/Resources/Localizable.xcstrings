    "Jeśli wysyłka się nie uda, kopia zostanie zapisana lokalnie.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the upload fails, the backup will be saved locally."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlägt das Hochladen fehl, wird die Sicherung lokal gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si la subida falla, la copia se guardará localmente."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо вивантаження не вдасться, копію буде збережено локально."
