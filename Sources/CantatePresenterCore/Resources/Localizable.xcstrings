    "Program rozpoznaje znaczniki:\n• [Zwrotka 1], [Zwrotka 2], [1], [2]\n• [Refren], [Refren 1], [R]\n• [Coda] lub [Koda]\n• [Bridge] lub [Mostek]\n• [Przejście] lub [Interlude]\n• [Zakończenie] lub [Ending]\n• [Intro] oraz [Outro]": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app recognizes these markers:\n• [Zwrotka 1], [Zwrotka 2], [1], [2] (verses)\n• [Refren], [Refren 1], [R] (chorus)\n• [Coda] or [Koda]\n• [Bridge] or [Mostek]\n• [Przejście] or [Interlude]\n• [Zakończenie] or [Ending]\n• [Intro] and [Outro]"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App erkennt diese Markierungen:\n• [Zwrotka 1], [Zwrotka 2], [1], [2] (Strophen)\n• [Refren], [Refren 1], [R] (Refrain)\n• [Coda] oder [Koda]\n• [Bridge] oder [Mostek]\n• [Przejście] oder [Interlude]\n• [Zakończenie] oder [Ending]\n• [Intro] und [Outro]"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La aplicación reconoce estas marcas:\n• [Zwrotka 1], [Zwrotka 2], [1], [2] (estrofas)\n• [Refren], [Refren 1], [R] (estribillo)\n• [Coda] o [Koda]\n• [Bridge] o [Mostek]\n• [Przejście] o [Interlude]\n• [Zakończenie] o [Ending]\n• [Intro] y [Outro]"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Програма розпізнає такі позначки:\n• [Zwrotka 1], [Zwrotka 2], [1], [2] (куплети)\n• [Refren], [Refren 1], [R] (приспів)\n• [Coda] або [Koda]\n• [Bridge] або [Mostek]\n• [Przejście] або [Interlude]\n• [Zakończenie] або [Ending]\n• [Intro] та [Outro]"
          }
        }
      }
    },
